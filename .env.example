# YouTube Shorts Automation - Environment Variables

# OpenAI API Key for script generation
OPENAI_API_KEY=your_openai_api_key_here

# YouTube API Credentials (choose one method)
# Option 1: OAuth2 Client Secrets File
YOUTUBE_CLIENT_SECRETS_FILE=path/to/client_secrets.json

# Option 2: Service Account File
YOUTUBE_SERVICE_ACCOUNT_FILE=path/to/service_account.json

# Optional: Custom configuration
# VIDEO_LENGTH=30
# OUTPUT_DIR=output
# TEMP_DIR=temp

# Email Notification Settings (for scheduled uploads)
# NOTIFICATION_EMAIL=your_email@example.com
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
